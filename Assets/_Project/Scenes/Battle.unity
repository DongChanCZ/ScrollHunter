  skipButton: {fileID: 1681555584}
  backButton: {fileID: 1466268357}
  titleFormat: "\uC804\uD22C {0} \uC2B9\uB9AC \xB7 HP {1:0} / {2:0}"
  chooseText: "\uBCF4\uC0C1 1\uAC1C\uB97C \uC120\uD0DD\uD558\uC138\uC694. \uD544\uC694
    \uC5C6\uC73C\uBA74 \uC2A4\uD0B5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  noChoicesText: "\uBC1B\uC744 \uC218 \uC788\uB294 \uBCF4\uC0C1\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
    \uC2A4\uD0B5 \uD6C4 \uC9C4\uD589\uD558\uC138\uC694."
  replaceFormat: "{0} \uC120\uD0DD \xB7 \uAD50\uCCB4\uD560 \uCE74\uB4DC 1\uC7A5\uC744
    \uB204\uB974\uC138\uC694."
  readyText: "\uD3B8\uC131\uC744 \uD655\uC778\uD558\uACE0 \uB2E4\uC74C \uC804\uD22C\uB85C
    \uC9C4\uD589\uD558\uC138\uC694."
  deckCardFormat: "{0}\uBC88 \xB7 {1}\n{2}"
  handLabel: "\uC2DC\uC791 \uC190\uD328"
  queueLabel: "\uB300\uAE30\uC5F4"
  reorderButton: {fileID: 310495996}
  saveOrderButton: {fileID: 2017363448}
  cancelOrderButton: {fileID: 628537611}
  dragIcon: {fileID: 1501013092}
  dropIndicator: {fileID: 2051563840}
  preparationTitle: "\uC2DC\uC791 \uD3B8\uC131"
  preparationText: "\uD3B8\uC131\uC744 \uD655\uC778\uD558\uACE0 \uC804\uD22C\uB97C
    \uC2DC\uC791\uD558\uC138\uC694."
  orderText: "\uCE74\uB4DC\uB97C \uC6D0\uD558\uB294 \uC790\uB9AC\uC5D0 \uB4DC\uB798\uADF8\uD558\uC138\uC694.
    1~4\uBC88\uC740 \uC2DC\uC791 \uC190\uD328, 5~8\uBC88\uC740 \uB300\uAE30\uC5F4\uC785\uB2C8\uB2E4."
  passiveChoiceFormat: "\uD328\uC2DC\uBE0C \xB7 {0}\n\uBCF4\uC720 {1}/{2}\n\uC120\uD0DD
    \uC989\uC2DC \uC801\uC6A9 \xB7 \uB371 \uC720\uC9C0"
  unlimitedPassiveChoiceFormat: "\uD328\uC2DC\uBE0C \xB7 {0}\n\uBCF4\uC720 {1}\n\uC120\uD0DD
    \uC989\uC2DC \uC801\uC6A9 \xB7 \uB371 \uC720\uC9C0"
